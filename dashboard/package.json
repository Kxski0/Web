{
  "name": "business-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Business-Dashboard für Kunden, Aufträge, Rechnungen, Projekte und Websites.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "test": "node scripts/core-test.mjs && node scripts/e2e.mjs",
    "test:core": "node scripts/core-test.mjs",
    "collections": "node scripts/gen-wix-collections.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
