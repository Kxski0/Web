  "permissions": {
    "read": "Admin",
    "insert": "Admin",
    "update": "Admin",
    "remove": "Admin"
  },
  "fields": [
    {
      "key": "title",
      "displayName": "Projektname",
      "type": "text",
      "required": true
    },
    {
      "key": "customerId",
      "displayName": "Kunde",
      "type": "text",
      "required": true,
      "description": "Verweis auf DashboardCustomers (_id)"
    },
    {
      "key": "value",
      "displayName": "Auftragswert",
      "type": "number",
      "required": false
    },
    {
      "key": "orderDate",
      "displayName": "Erstellungsdatum",
      "type": "text",
      "required": false,
      "description": "ISO-Tagesformat YYYY-MM-DD"
    },
    {
      "key": "deadline",
      "displayName": "Deadline",
      "type": "text",
      "required": false,
      "description": "ISO-Tagesformat YYYY-MM-DD"
    },
    {
      "key": "status",
      "displayName": "Status",
      "type": "text",
      "required": true,
      "description": "Erlaubt: anfrage, angebot, angenommen, in_bearbeitung, wartet_kunde, abgeschlossen, storniert"
    },
    {
      "key": "paymentStatus",
      "displayName": "Zahlungsstatus",
      "type": "text",
      "required": true,
      "description": "Erlaubt: offen, teilbezahlt, bezahlt"
    },
    {
      "key": "description",
      "displayName": "Beschreibung",
      "type": "text",
      "required": false
    },
    {
      "key": "notes",
      "displayName": "Notizen",
      "type": "text",
      "required": false
    }
  ]
}
