# ---------------------------------------------------------------------------
# Kontaktformular
# ---------------------------------------------------------------------------
# Ziel-Endpunkt für Formularanfragen. Nimmt einen JSON-POST entgegen — ein
# Mail-Dienst, ein CRM-Eingang oder ein Automations-Webhook.
#
# Solange die Variable nicht gesetzt ist, antwortet /api/kontakt bewusst mit
# HTTP 503 und einer klaren Meldung, statt einen Erfolg vorzutäuschen und echte
# Anfragen zu verlieren.
CONTACT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Suchmaschinen-Indexierung
# ---------------------------------------------------------------------------
# Standard ist AUS. Nur auf "true" setzen, wenn dieses Deployment tatsächlich
# öffentlich gefunden werden soll — und erst, wenn Impressum und
# Datenschutzerklärung vollständig sind (siehe CONTENT-TODO.md).
#
# Ist die Variable nicht "true", liefert robots.txt ein vollständiges Disallow
# und jede Seite ein noindex.
SITE_INDEXABLE=

# ---------------------------------------------------------------------------
# Domain
# ---------------------------------------------------------------------------
# Kanonischer Ursprung ohne abschließenden Schrägstrich, z.B.
# https://www.solbautec.de
#
# Nicht gesetzt: Auf Vercel wird die Produktionsdomain automatisch verwendet,
# sonst https://www.solbautec.de. Davon leiten sich Canonical, Open Graph,
# Sitemap und robots.txt ab.
NEXT_PUBLIC_SITE_URL=
