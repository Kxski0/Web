# Kontaktformular
#
# Ziel-Endpunkt für Formularanfragen. Nimmt einen JSON-POST entgegen — ein
# Mail-Dienst, ein CRM-Eingang oder ein Automations-Webhook.
#
# Solange die Variable nicht gesetzt ist, antwortet /api/kontakt bewusst mit
# HTTP 503 und einer klaren Meldung, statt einen Erfolg vorzutäuschen und echte
# Anfragen zu verlieren.
CONTACT_WEBHOOK_URL=
